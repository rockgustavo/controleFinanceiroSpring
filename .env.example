# PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_NAME=financeiro
DB_USERNAME=financeiro
DB_PASSWORD=financeiro

# Keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_INTERNAL_URL=http://localhost:8180
KEYCLOAK_REALM=financeiro
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
CLOUDAMQP_URL=amqp://guest:guest@localhost:5672

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Spring
SPRING_PROFILE=dev

# BRAPI (opcional — ibovespa/ivvb11 ficam nulos sem token)
BRAPI_TOKEN=
